SESSION_DRIVER=memory

# Database: el servicio `db-test` de compose.yaml, efímero y en memoria.
# AdonisJS solo carga este fichero cuando NODE_ENV=test (lo fija bin/test.ts), y
# sus valores pisan los de `.env`. Va el juego completo y no solo el puerto para
# que no dependa de lo que haya en `.env`: en CI ese fichero no existe.
DB_HOST=127.0.0.1
DB_PORT=54411
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_test
